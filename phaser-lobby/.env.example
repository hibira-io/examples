# The app key from your app page on https://hibira.io/portal (the key, not
# the secret: this game runs in the browser). Use the same app as
# nextjs-lobby, which signs room subscriptions for this game.
VITE_HIBIRA_APP_KEY=
# ws.hibira.io for the default cluster, ws-<cluster>.hibira.io otherwise.
VITE_HIBIRA_HOST=ws.hibira.io
# Only for a self-hosted or local server:
# VITE_HIBIRA_PORT=443
# VITE_HIBIRA_SCHEME=https
# Where nextjs-lobby runs. The dev server forwards /api there.
# LOBBY_BACKEND=http://localhost:3000
