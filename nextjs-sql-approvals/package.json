{
  "name": "hibira-nextjs-sql-approvals",
  "private": true,
  "version": "1.0.0",
  "description": "Supervisor approval for database changes on Hibira: reads run at once, a change waits until a supervisor approves its exact SQL and estimated rows",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hibira-io/approvals": "^0.2.0",
    "next": "^16.4.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.3"
  },
  "stackblitz": {
    "startCommand": "npm run dev"
  }
}
