# From your app page on https://hibira.io/portal (the free plan is enough).
HIBIRA_APP_ID=
HIBIRA_APP_SECRET=
NEXT_PUBLIC_HIBIRA_APP_KEY=
# ws.hibira.io for the default cluster, ws-<cluster>.hibira.io otherwise.
NEXT_PUBLIC_HIBIRA_HOST=ws.hibira.io
# Only for a self-hosted or local server:
# NEXT_PUBLIC_HIBIRA_PORT=443
# NEXT_PUBLIC_HIBIRA_SCHEME=https
# Raw bytes per relayed chunk; 2700 fits the free plan's 4 KB event limit.
# NEXT_PUBLIC_RELAY_CHUNK_BYTES=2700
