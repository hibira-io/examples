APP_NAME="Hibira Agent Approvals Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=zh_TW

# Local demo only: one-click sign-in as the seeded demo users on /login.
# Refused when APP_ENV=production. Keep it false on any shared deployment.
DEMO_MODE=true
# Password of the seeded demo users (php artisan demo:reset).
DEMO_PASSWORD=demo-password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL keeps orders, approvals, refunds, the agent's conversation,
# sessions and the database queue.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=demo
DB_USERNAME=demo
DB_PASSWORD=demo

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# Agent turns run on the queue: run `php artisan queue:work` next to the app.
QUEUE_CONNECTION=database
# Optional: a dedicated queue for decided approvals (then run queue:work --queue=approvals,default).
HIBIRA_APPROVALS_QUEUE=

BROADCAST_CONNECTION=hibira

# Hibira app from https://hibira.io/portal (the free plan is enough).
# HIBIRA_APP_SECRET stays on the server; only the key and host reach the browser.
HIBIRA_APP_ID=
HIBIRA_APP_KEY=
HIBIRA_APP_SECRET=
HIBIRA_HOST=ws.hibira.io
HIBIRA_PORT=443
HIBIRA_SCHEME=https

# Optional: Hibira Push, for approvers who don't have the panel open.
HIBIRA_PUSH_INSTANCE_ID=
HIBIRA_PUSH_SECRET_KEY=

# Mock mode (default): no model API key. Only the model's output is replaced.
AI_PROVIDER=demo-mock
DEMO_MOCK_AI_DELAY_MS=60
DEMO_MOCK_AI_FAILURE=false

# Live mode: a Laravel AI SDK provider name from config/ai.php and its key,
# for example AI_PROVIDER=openai with OPENAI_API_KEY, or AI_PROVIDER=gemini
# with GEMINI_API_KEY. AI_MODEL is optional (the SDK's default model).
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

MAIL_MAILER=log
