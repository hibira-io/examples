; Engine configuration file.

config_version=5

[application]

config/name="Hibira Reaction Rooms"
config/description="A multiplayer lobby and reaction game on Hibira presence channels."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://addons/hibira/icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/hibira/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
