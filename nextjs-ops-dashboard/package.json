{
  "name": "hibira-nextjs-ops-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "An ops dashboard two ways: every viewer polling Postgres, or one query a second pushed to everyone over Hibira",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "publisher": "tsx --env-file=.env.local scripts/publisher.ts",
    "traffic": "tsx --env-file=.env.local scripts/traffic.ts",
    "viewers": "tsx --env-file=.env.local scripts/viewers.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hibira-io/large-presence": "^0.1.1",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
